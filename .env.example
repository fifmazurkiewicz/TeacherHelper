# =============================================================================
# TeacherHelper — .env w KORNIU repozytorium (TeacherHelper/.env)
# Skopiuj ten plik jako ../.env (obok folderów backend/ i frontend/).
# =============================================================================

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/teacherhelper
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/teacherhelper

# ---------- Supabase (produkcja / dev cloud) ----------
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_JWKS_URL=https://xxxx.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=teacherhelper
# STORAGE_BACKEND=supabase

# ---------- Storage lokalny (dev bez Supabase Storage) ----------
STORAGE_BACKEND=local
STORAGE_ROOT=./data/storage

# ---------- Auth legacy (tylko gdy SUPABASE_URL puste — dev) ----------
JWT_SECRET=zmien-na-losowy-ciag-min-32-znaki

# ---------- Flagi produktu ----------
VIDEO_GENERATION_ENABLED=false
OPENAPI_DOCS=true
# CORS_ORIGINS=http://127.0.0.1:18080,http://localhost:3000

# ---------- OpenRouter (wymagane do czatu) ----------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_MODULE_MODEL=google/gemini-3-flash-preview
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview

# ---------- Embeddingi (pgvector w Postgresie) ----------
EMBEDDINGS_BACKEND=auto
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------- Seed admina (migracja 007) — produkcja: SKIP_ADMIN_SEED=1 ----------
# SKIP_ADMIN_SEED=0
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=ChangeMeAdmin123!

# ---------- Admin (Supabase Auth) — tylko te e-maile mają rolę admin ----------
ADMIN_EMAILS=fifmazurkiewicz@gmail.com

# Szczegóły pozostałych integracji: backend/.env.example i docs/technical/configuration.md
